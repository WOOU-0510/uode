{
  "name": "@uode/base-ui-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./icons/registry": {
      "types": "./dist/icons/registry.d.mts",
      "import": "./dist/icons/registry.mjs",
      "default": "./dist/icons/registry.mjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.mts",
      "import": "./dist/icons/*.mjs",
      "default": "./dist/icons/*.mjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsdown"
  },
  "dependencies": {
    "@uode/base-ui-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:peer",
    "react-dom": "catalog:peer",
    "classnames": "catalog:peer"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tooling",
    "@tsdown/css": "catalog:bundler",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "lightningcss": "catalog:web",
    "sass": "catalog:web",
    "tsdown": "catalog:bundler",
    "typescript": "catalog:tooling"
  }
}
